SQLI_SENTINEL_APP_NAME=SQLI Sentinel Backend
SQLI_SENTINEL_APP_VERSION=2.0.0
SQLI_SENTINEL_ENV=development
SQLI_SENTINEL_LOG_LEVEL=INFO

# Comma-separated list
SQLI_SENTINEL_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Security
SQLI_SENTINEL_SECRET=change-me
SQLI_SENTINEL_SESSION_TTL_HOURS=24
SQLI_SENTINEL_PBKDF2_ITERATIONS=210000
SQLI_SENTINEL_RATE_LIMIT_PER_MINUTE=120
SQLI_SENTINEL_REQUEST_SIZE_LIMIT_BYTES=262144

# Database
SQLI_SENTINEL_DB_PATH=backend_v2/data/sqli_sentinel.db

# Observability
SQLI_SENTINEL_ENABLE_METRICS=true
SQLI_SENTINEL_MAX_REPORT_EXPORT_ROWS=5000

# AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
SQLI_SENTINEL_AI_TIMEOUT_SECONDS=20

# Seeder
SQLI_SENTINEL_SEED_DEFAULT_ADMIN=true
SQLI_SENTINEL_DEFAULT_ADMIN_EMAIL=admin@sqli-sentinel.local
SQLI_SENTINEL_DEFAULT_ADMIN_PASSWORD=Admin123!
